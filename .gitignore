# Build outputs
/dist/
/runtime-debs/
/tmp/
/vpp-master/
/govpp-master/
/build/
*.log

# Firmware, package, plugin, and VM outputs are reproducible artifacts.
*.iso
*.img
*.img.zst
*.qcow2
*.vmdk
*.deb
# Pinned VPP development packages: the release workflow builds the plugin
# from these exact inputs, so they are source, not build output.
!runtime-downloads/*.deb
*.so
*.tar
*.tar.gz
*.tar.zst

# Local compiler and acceptance scratch directories.
/.codex-tmp/
/.acceptance/
/.codex-build/
/.tmp*/
/config/build/
/deploy/*/artifacts/

# CI downloads are fetched on demand and must never enter Git history.
/third_party/ophub-cache/

# Local/browser verification artifacts
.playwright-mcp/
/e2e/artifacts/
/.sisyphus/
/panabit-real/

# Python/runtime caches
__pycache__/
*.py[cod]

# Heavy upstream/reference blobs kept locally only
*.pdf
PanabitOEM_TANGr7p8_20260414_Linux3.tar.gz

# Dependencies and OS/editor noise
node_modules/
/frontend/node_modules/
.DS_Store

# Product UI build outputs
/frontend/dist/
*.tsbuildinfo
