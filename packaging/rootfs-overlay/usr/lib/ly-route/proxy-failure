#!/bin/sh
# Ly Route proxy failure-page actuator.
#
# enter  Install a dedicated nftables failure generation and flush the normal
#        proxy TPROXY chain. IPv4 TCP/80 arriving on the proxy ingress TAP is
#        redirected to the local failure page, TCP/443 is reset, DNS and the
#        service/LAN/reserved destinations stay direct, and every other
#        captured TCP/UDP packet is dropped. The page is therefore served
#        locally and traffic can never fall through to the direct Internet.
# leave  Remove the failure generation. The caller must re-install the normal
#        capture generation *before* calling leave when a proxy is healthy.
# status Print "active" or "inactive"; exit 0 only when the page is active.
#
# Two tables are used on purpose. A filter chain and a NAT chain in the same
# nftables table are not both traversed on this kernel: the NAT chain is
# skipped. Keeping the redirect (nat) and the guard (filter) in separate
# tables with the guard after the NAT priority makes the translated TCP/80
# packet visible to the guard, so its destination bypass can accept it while
# every other captured packet is dropped.
#
# The state file is written by the control API (and read by the systemd fast
# path) at:
#   /var/lib/ly-route/proxy-failure.json
# Override with LY_ROUTE_PROXY_FAILURE_STATE (tests) and LY_ROUTE_NFT.
#
# enter accepts optional positional overrides for the independent netns test:
#   proxy-failure enter <ingress> <page-port> [cidr ...]
# Without arguments the values are read from the state file.
set -u

MODE=${1:-}
[ "$#" -gt 0 ] && shift
STATE=${LY_ROUTE_PROXY_FAILURE_STATE:-/var/lib/ly-route/proxy-failure.json}
NFT=${LY_ROUTE_NFT:-/usr/sbin/nft}
PAGE_PORT=${LY_ROUTE_PROXY_FAILURE_PAGE_PORT:-8081}

CAPTURE_FAMILY=inet
CAPTURE_TABLE=ly_route_proxy_capture
CAPTURE_CHAIN=proxy_prerouting
FAILURE_TABLE=ly_route_proxy_failure
GUARD_TABLE=ly_route_proxy_failure_guard

log() { printf 'ly-route-proxy-failure: %s\n' "$*" >&2; }

usage() {
    printf 'usage: %s enter [ingress page-port cidr...] | leave | status\n' "$0" >&2
    exit 2
}

# load_state validates the persisted configuration and exports INGRESS,
# PAGE_PORT and BYPASS (space separated). It deliberately refuses unsafe
# interface names, ports and prefixes instead of guessing.
load_state() {
    [ -f "$STATE" ] || {
        log "no failure-page state at $STATE"
        return 1
    }
    rendered=$(python3 - "$STATE" <<'PY'
import ipaddress, json, re, shlex, sys

try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception as exc:
    sys.exit("state file is not valid JSON: %s" % exc)
if not isinstance(data, dict) or not data.get("enabled", False):
    sys.exit("state file does not describe an enabled proxy egress")

ingress = str(data.get("ingress_interface") or "").strip()
if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", ingress):
    sys.exit("state file has an unsafe ingress interface")
try:
    port = int(data.get("page_port") or 8081)
except (TypeError, ValueError):
    sys.exit("state file has an invalid page port")
if not 1 <= port <= 65535:
    sys.exit("state file page port is out of range")
prefixes = []
for raw in data.get("bypass_destinations") or []:
    try:
        prefix = ipaddress.ip_network(str(raw).strip(), strict=False)
    except ValueError:
        sys.exit("state file has an invalid bypass destination")
    if prefix.version == 4:
        prefixes.append(str(prefix))
print("INGRESS=" + shlex.quote(ingress))
print("PAGE_PORT=" + shlex.quote(str(port)))
print("BYPASS=" + shlex.quote(" ".join(prefixes)))
PY
) || return 1
    eval "$rendered"
}

# render_rules emits a single atomic nftables batch. Installing the failure
# tables and flushing the capture chain in one transaction leaves no window in
# which captured traffic could use the direct path.
render_rules() {
    python3 - "$INGRESS" "$PAGE_PORT" "$BYPASS" "$CAPTURE_FLUSH" <<'PY'
import ipaddress, sys

ingress, port, bypass, capture_flush = sys.argv[1:5]
try:
    port = int(port)
except ValueError:
    sys.exit("page port is invalid")

# Always bypass loopback, link-local, multicast/reserved and broadcast.
# The caller adds the proxy service /30 peers and resolved LAN routes. The
# ingress service /30 matters twice: the redirect rewrites the destination to
# the ingress interface address, which the guard must let through.
prefixes = ["127.0.0.0/8", "169.254.0.0/16", "224.0.0.0/4", "240.0.0.0/4", "255.255.255.255/32"]
for raw in bypass.split():
    prefix = ipaddress.ip_network(raw, strict=False)
    if prefix.version == 4:
        prefixes.append(str(prefix))
seen = set()
ordered = []
for prefix in prefixes:
    if prefix not in seen:
        seen.add(prefix)
        ordered.append(prefix)

lines = [
    "add table inet ly_route_proxy_failure",
    "flush table inet ly_route_proxy_failure",
    "add table inet ly_route_proxy_failure_guard",
    "flush table inet ly_route_proxy_failure_guard",
    "table inet ly_route_proxy_failure {",
    "  chain redirect_page {",
    "    type nat hook prerouting priority -140; policy accept;",
    '    iifname "%s" meta mark 0x0 meta nfproto ipv4 tcp dport 80 counter redirect to :%d' % (ingress, port),
    "  }",
    "}",
    "table inet ly_route_proxy_failure_guard {",
    "  chain fail_closed {",
    # The guard must run after dstnat so it sees the translated page packet;
    # this kernel skips a nat hook that is followed by a filter hook with a
    # lower priority in the same hook path.
    "    type filter hook prerouting priority -50; policy accept;",
    '    iifname != "%s" return' % ingress,
    "    meta mark != 0 return",
    "    meta nfproto != ipv4 return",
    "    tcp dport 53 return",
    "    udp dport 53 return",
]
for prefix in ordered:
    lines.append("    ip daddr %s return" % prefix)
lines += [
    "    meta l4proto != tcp meta l4proto != udp return",
    "    meta l4proto tcp tcp dport 443 counter reject with tcp reset",
    "    meta l4proto tcp counter drop",
    "    meta l4proto udp counter drop",
    "  }",
    "}",
]
if capture_flush:
    lines.append(capture_flush)
print("\n".join(lines))
PY
}

enter() {
    if [ "$#" -ge 2 ]; then
        INGRESS=$1
        PAGE_PORT=$2
        shift 2
        BYPASS=$*
    elif [ "$#" -eq 0 ]; then
        load_state || exit 1
    else
        usage
    fi
    if ! printf '%s' "$INGRESS" | grep -Eq '^[A-Za-z0-9_.:-]{1,15}$'; then
        log "refusing unsafe ingress interface"
        exit 1
    fi
    case "$PAGE_PORT" in
        ''|*[!0-9]*) log "invalid page port"; exit 1 ;;
    esac
    [ "$PAGE_PORT" -ge 1 ] && [ "$PAGE_PORT" -le 65535 ] || {
        log "page port $PAGE_PORT is out of range"
        exit 1
    }

    CAPTURE_FLUSH=""
    if "$NFT" list chain "$CAPTURE_FAMILY" "$CAPTURE_TABLE" "$CAPTURE_CHAIN" >/dev/null 2>&1; then
        CAPTURE_FLUSH="flush chain $CAPTURE_FAMILY $CAPTURE_TABLE $CAPTURE_CHAIN"
    fi
    RULES=$(render_rules) || {
        log "failed to render failure rules"
        exit 1
    }
    printf '%s\n' "$RULES" | "$NFT" -f - || {
        log "failed to install the failure generation"
        exit 1
    }
    log "failure page active: $INGRESS tcp/80 -> :$PAGE_PORT, tcp/443 reset, other captured tcp/udp dropped"
}

leave() {
    failed=0
    for table in "$FAILURE_TABLE" "$GUARD_TABLE"; do
        if "$NFT" list table "$CAPTURE_FAMILY" "$table" >/dev/null 2>&1; then
            "$NFT" delete table "$CAPTURE_FAMILY" "$table" || failed=1
        fi
    done
    if [ "$failed" -ne 0 ]; then
        log "failed to remove the failure generation"
        exit 1
    fi
    log "failure page removed"
}

status() {
    if "$NFT" list table "$CAPTURE_FAMILY" "$FAILURE_TABLE" >/dev/null 2>&1; then
        printf 'active\n'
        exit 0
    fi
    printf 'inactive\n'
    exit 1
}

case "$MODE" in
    enter) enter "$@" ;;
    leave) leave "$@" ;;
    status) status ;;
    *) usage ;;
esac
