#!/bin/sh
# Keep the proxy dataplane fail closed across Xray stop, crash and reboot.
#
# on  (ExecStartPost): wait for the TPROXY listener, then re-apply the
#     persisted nftables generation, remove the VPP fail-open bypasses and
#     remove any failure page/blackhole generation. If the listener never
#     becomes ready, keep VPP steering to the ingress TAP active and publish
#     the fixed local failure page (or a blackhole if the page cannot be
#     served). Traffic must never fall through to the direct Internet while a
#     proxy egress is configured.
# off (ExecStopPost):  remove stale VPP bypass rules, keep VPP steering to the
#     ingress TAP active, flush host capture and install the failure
#     page/blackhole before traffic could escape. Only when no proxy egress is
#     configured (no persisted failure state) does it fall back to the legacy
#     VPP direct bypass, because then direct forwarding is the product
#     behaviour.
set -u

MODE=${1:-}
NFT=${LY_ROUTE_NFT:-/usr/sbin/nft}
VPPCTL=${LY_ROUTE_VPPCTL:-vppctl}
CONF=${LY_ROUTE_NFT_CONF:-/etc/nftables.conf}
XRAY_CONFIG=${LY_ROUTE_XRAY_CONFIG:-/etc/xray/config.json}
PRE_NAT_SHOW=${LY_ROUTE_PRE_NAT_SHOW:-}
FAILURE_HELPER=${LY_ROUTE_PROXY_FAILURE_HELPER:-/usr/lib/ly-route/proxy-failure}
FAILURE_STATE=${LY_ROUTE_PROXY_FAILURE_STATE:-/var/lib/ly-route/proxy-failure.json}
CAPTURE_FAMILY=inet
CAPTURE_TABLE=ly_route_proxy_capture
CAPTURE_CHAIN=proxy_prerouting
BYPASS_BASE=9000
BYPASS_MAX=64

log() { printf 'ly-route-proxy-failopen: %s\n' "$*" >&2; }

show_rules() {
    if [ -n "$PRE_NAT_SHOW" ]; then
        cat "$PRE_NAT_SHOW" 2>/dev/null || true
        return
    fi
    "$VPPCTL" show ly-route pre-nat-route detail 2>/dev/null || true
}

vpp_set() {
    if [ -n "$PRE_NAT_SHOW" ]; then
        # Test/fixture mode records commands instead of touching VPP.
        [ -n "${LY_ROUTE_VPP_LOG:-}" ] && printf '%s\n' "$*" >>"$LY_ROUTE_VPP_LOG"
        return 0
    fi
    "$VPPCTL" "$@" >/dev/null 2>&1
}

flush_capture() {
    "$NFT" flush chain "$CAPTURE_FAMILY" "$CAPTURE_TABLE" "$CAPTURE_CHAIN" 2>/dev/null || true
}

install_capture() {
    [ -f "$CONF" ] || {
        log "no $CONF, leaving capture fail-open"
        return 1
    }
    "$NFT" -f "$CONF" || {
        log "failed to apply $CONF, leaving capture fail-open"
        return 1
    }
}

tproxy_ports() {
    [ -f "$XRAY_CONFIG" ] || return 0
    python3 - "$XRAY_CONFIG" <<'PY' 2>/dev/null || true
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    raise SystemExit(0)
for inbound in data.get("inbounds", []):
    sockopt = (inbound.get("streamSettings") or {}).get("sockopt") or {}
    if inbound.get("protocol") != "dokodemo-door" or sockopt.get("tproxy") != "tproxy":
        continue
    try:
        port = int(inbound.get("port"))
    except (TypeError, ValueError):
        continue
    if 0 < port < 65536:
        print(port)
PY
}

listening_port() {
    port=$1
    ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -q ":$port\$"
}

wait_listener() {
    ports=$(tproxy_ports)
    [ -n "$ports" ] || return 0
    attempt=0
    while [ "$attempt" -lt "${LY_ROUTE_LISTENER_WAIT_ATTEMPTS:-100}" ]; do
        ready=1
        for port in $ports; do
            listening_port "$port" || ready=0
        done
        [ "$ready" = 1 ] && return 0
        attempt=$((attempt + 1))
        sleep 0.2
    done
    return 1
}

delete_bypass() {
    show_rules | awk '
        $1 == "rule" {
            id = bypass = "";
            for (i = 1; i <= NF; i++) {
                if ($i == "id") id = $(i + 1);
                else if ($i == "bypass") bypass = $(i + 1);
            }
            if ((bypass + 0) == 1 && (id + 0) >= '"$BYPASS_BASE"' && (id + 0) < '"$((BYPASS_BASE + BYPASS_MAX))"')
                print id;
        }' | while read -r id; do
        [ -n "$id" ] || continue
        vpp_set set ly-route pre-nat-route del id "$id" || log "delete bypass $id failed"
    done
}

add_bypass() {
    # Replace any previous reservation so repeated stop/crash events cannot
    # accumulate duplicate rules with our reserved ids.
    delete_bypass
    tmp=$(mktemp 2>/dev/null) || return 1
    show_rules | awk '
        $1 == "rule" {
            id = prio = src = dst = proto = sport = dport = skip = bypass = "";
            for (i = 1; i <= NF; i++) {
                if ($i == "id") id = $(i + 1);
                else if ($i == "priority") prio = $(i + 1);
                else if ($i == "source") src = $(i + 1);
                else if ($i == "destination") dst = $(i + 1);
                else if ($i == "protocol") proto = $(i + 1);
                else if ($i == "sport") sport = $(i + 1);
                else if ($i == "dport") dport = $(i + 1);
                else if ($i == "skip-nat") skip = $(i + 1);
                else if ($i == "bypass") bypass = $(i + 1);
            }
            if ((skip + 0) == 1 && (bypass + 0) == 0)
                print id, prio, src, dst, proto, sport, dport;
        }' >"$tmp"

    index=0
    while read -r id prio src dst proto sport dport; do
        [ -n "${id:-}" ] || continue
        index=$((index + 1))
        [ "$index" -le "$BYPASS_MAX" ] || break
        case "$proto" in
            0) protocol=any ;;
            6) protocol=tcp ;;
            17) protocol=udp ;;
            1) protocol=icmp ;;
            *) log "skip proxy rule $id with protocol $proto"; continue ;;
        esac
        bypass_priority=$prio
        if [ "$bypass_priority" -gt 0 ] 2>/dev/null; then
            bypass_priority=$((bypass_priority - 1))
        fi
        bypass_id=$((BYPASS_BASE + index))
        # Same selector as the proxy rule, one step earlier in priority (and
        # a lower id as the tie-break).  The plugin then keeps the packet on
        # the normal NAT path instead of the proxy skip-nat FIB.
        vpp_set set ly-route pre-nat-route add id "$bypass_id" priority "$bypass_priority" \
            source "$src" destination "$dst" protocol "$protocol" \
            sport "$sport" dport "$dport" bypass || log "add bypass for rule $id failed"
    done <"$tmp"
    rm -f "$tmp"
}

# A proxy egress is selected when the control API persisted its failure-page
# state. Without it, direct forwarding is the intended behaviour.
proxy_egress_selected() {
    [ -f "$FAILURE_STATE" ]
}

failure_enter() {
    if [ -x "$FAILURE_HELPER" ]; then
        if "$FAILURE_HELPER" enter; then
            return 0
        fi
        log "failure page helper failed; trying blackhole mode"
        if "$FAILURE_HELPER" blackhole; then
            return 0
        fi
    fi
    log "failure helper unavailable; installing inline blackhole"
    inline_blackhole
}

# inline_blackhole is the last line of defence: even if the packaged helper is
# missing or broken, captured TCP/UDP must be dropped rather than forwarded.
inline_blackhole() {
    [ -f "$FAILURE_STATE" ] || return 1
    ingress=$(python3 - "$FAILURE_STATE" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    raise SystemExit(1)
sys.stdout.write(str(data.get("ingress_interface") or ""))
PY
) || return 1
    case "$ingress" in
        ""|*[!A-Za-z0-9_.:-]*) return 1 ;;
    esac
    "$NFT" -f - <<EOF || return 1
add table inet ly_route_proxy_failure_guard
flush table inet ly_route_proxy_failure_guard
table inet ly_route_proxy_failure_guard {
  chain fail_closed {
    type filter hook prerouting priority -50; policy accept;
    iifname != "$ingress" return
    meta mark != 0 return
    meta nfproto != ipv4 return
    tcp dport 53 return
    udp dport 53 return
    ip daddr 127.0.0.0/8 return
    ip daddr 169.254.0.0/16 return
    ip daddr 224.0.0.0/4 return
    ip daddr 240.0.0.0/4 return
    meta l4proto != tcp meta l4proto != udp return
    meta l4proto tcp tcp dport 443 counter reject with tcp reset
    meta l4proto tcp counter drop
    meta l4proto udp counter drop
  }
}
EOF
    flush_capture
}

case "$MODE" in
    on)
        if wait_listener; then
            if install_capture; then
                if [ -x "$FAILURE_HELPER" ] && proxy_egress_selected; then
                    "$FAILURE_HELPER" leave || log "failed to clear the failure page"
                fi
                delete_bypass
                log "capture installed and proxy steering enabled"
                exit 0
            fi
        else
            log "TPROXY listener did not become ready"
        fi
        if proxy_egress_selected; then
            # Keep VPP steering to the ingress TAP; drop or page locally.
            delete_bypass
            if failure_enter; then
                log "proxy unavailable: local failure page/blackhole active"
            else
                log "failure helper unavailable; keeping capture flushed (fail closed)"
                flush_capture
            fi
            exit 0
        fi
        # No proxy egress is selected: direct forwarding is correct.
        add_bypass
        flush_capture
        exit 0
        ;;
    off)
        if proxy_egress_selected; then
            # Remove any legacy direct bypass so VPP keeps steering into the
            # ingress TAP where the local page or the blackhole guard runs.
            delete_bypass
            if failure_enter; then
                log "capture removed and local failure page/blackhole enabled"
            else
                log "failure helper unavailable; keeping capture flushed (fail closed)"
                flush_capture
            fi
            exit 0
        fi
        add_bypass
        flush_capture
        log "capture removed and proxy steering bypassed (no proxy egress selected)"
        exit 0
        ;;
    *)
        printf 'usage: %s on|off\n' "$0" >&2
        exit 2
        ;;
esac
