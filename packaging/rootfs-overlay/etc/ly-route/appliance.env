LY_ROUTE_ADMIN_PORT=443
LY_ROUTE_ADMIN_USERNAME=admin
# Credentials are generated on first boot and stored root-only.
# Do not embed factory passwords in the image.
LY_ROUTE_FORCE_PASSWORD_CHANGE=true
LY_ROUTE_SESSION_COOKIE_SECURE=true
LY_ROUTE_DHCP_CLIENT=no
LY_ROUTE_MANAGEMENT_FALLBACK=yes
LY_ROUTE_MANAGEMENT_FALLBACK_CIDR=192.168.88.254/24
LY_ROUTE_MANAGEMENT_FALLBACK_ROUTE_METRIC=4096
LY_ROUTE_MANAGEMENT_FALLBACK_GATEWAY=192.168.88.1
