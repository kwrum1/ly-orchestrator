[Unit]
Description=Ly Route SmartDNS IP set to VPP policy synchronization
After=smartdns.service ly-route-control-api.service
Wants=smartdns.service ly-route-control-api.service

[Service]
Type=oneshot
# Bound the whole synchronization so a wedged control API cannot leave a
# start job (and the timer) occupied indefinitely.
TimeoutStartSec=60s
TimeoutStopSec=15s
Environment=LY_ROUTE_DNS_SYNC_API_TIMEOUT_SECONDS=10
# Create policy-referenced sets before the first observation pass.
ExecStartPre=-/usr/bin/timeout 15 /usr/lib/ly-route/dns-ipset-sync.py --prepare
ExecStart=/usr/lib/ly-route/dns-ipset-sync.py
